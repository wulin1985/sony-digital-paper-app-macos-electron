 const electron = require('electron');
 
+// [arm64-port] Node >= 17 resolves 'localhost' per-OS-order (macOS prefers ::1).
+// The mw-port-fwdr local forwarder binds to 'localhost' while consumers force
+// family:4 (127.0.0.1), causing ECONNREFUSED after the Electron 10 (Node 12) upgrade.
+// Restore legacy IPv4-first ordering process-wide.
+try { require('dns').setDefaultResultOrder('ipv4first'); } catch (e) { /* older node */ }
+
+// [arm64-port] All Web API XHRs target https://digitalpaper.local:<local port
+// forwarder port>. On modern Chromium, .local resolves via mDNS to the
+// DEVICE's IP, where nothing listens on the forwarder's port. At the same
+// time the hostname must NOT change in the URL: the device sets its session
+// cookie with 'Domain=digitalpaper.local' (and its CORS policy only allows
+// Origin null with credentials). Map the hostname to 127.0.0.1 at the
+// Chromium network layer so XHRs reach the LOCAL port forwarder while URL,
+// Host header and cookie domain matching all stay 'digitalpaper.local'.
+// (mDNS discovery in mw-discovery-ctrl uses its own UDP stack in the main
+// process and is unaffected.)
+electron.app.commandLine.appendSwitch('host-rules', 'MAP digitalpaper.local 127.0.0.1');
+
+// [arm64-port] Electron >= 14 removed the built-in remote module; the legacy
+// UI stack (mw-conn-ctrl and 18+ view files) still reads `electron.remote`.
+// @electron/remote restores it; preload.js exposes it to renderers.
+try {
+    const remoteMain = require('@electron/remote/main');
+    remoteMain.initialize();
+    // [arm64-port] @electron/remote requires per-WebContents enable();
+    // enable for every window this app creates (main + dialogs).
+    electron.app.on('web-contents-created', function (event, webContents) {
+        try { remoteMain.enable(webContents); } catch (e) { /* ignore */ }
+    });
+    // [arm64-port] On Electron >= 28 @electron/remote resolves remote.require()
+    // through a module walk that lands on an internal electron module, losing
+    // the app's node_modules path. Intercept 'remote-require' and resolve from
+    // this main.js context instead.
+    // Module.createRequire pins resolution to this main.js file regardless of
+    // how Electron wires up require.main (whose .paths is undefined on >= 28).
+    const { createRequire } = require('module');
+    const mainRequire = createRequire(require('path').join(__dirname, 'main.js'));
+    electron.app.on('remote-require', function (event, webContents, moduleName) {
+        try {
+            event.returnValue = mainRequire(moduleName);
+        } catch (e) {
+            console.warn('[arm64-port] remote-require resolve failed:', moduleName, e.message);
+        }
+    });
+} catch (e) {
+    console.error('[arm64-port] @electron/remote/main initialize failed:', e);
+}
