+// [arm64-port] Device session cookie relay.
+// The device authenticates via a 'Credentials' cookie set by PUT /auth
+// (Set-Cookie: Credentials=...; Domain=digitalpaper.local; Secure - no
+// SameSite attribute). On the original Electron 10 (Chromium 85) the
+// SameSite-by-default policy was not yet in effect, so cross-site XHRs
+// from the file:// UI carried the cookie. Modern Chromium defaults to
+// SameSite=Lax and additionally restricts third-party cookies, so the
+// browser neither stores nor sends it - every API call after a
+// successful auth returned 401/40100. Relay the cookie at the network
+// layer instead: capture it from device responses and inject it into
+// subsequent device requests. (Header key casing is inconsistent in
+// Electron 44 - 'Set-Cookie' vs 'set-cookie' - so match case-insensitively.)
+app.on('ready', function () {
+    const session = electron.session;
+    let deviceCookie = null;
+    const isDeviceUrl = function (url) {
+        return typeof url === 'string' && url.indexOf('digitalpaper.local') >= 0;
+    };
+    const pickSetCookie = function (headers) {
+        if (!headers) { return null; }
+        const keys = Object.keys(headers);
+        for (let i = 0; i < keys.length; i++) {
+            if (keys[i].toLowerCase() === 'set-cookie') { return headers[keys[i]]; }
+        }
+        return null;
+    };
+    session.defaultSession.webRequest.onHeadersReceived(function (details, callback) {
+        if (isDeviceUrl(details.url)) {
+            const sc = pickSetCookie(details.responseHeaders);
+            if (sc && sc.length) {
+                deviceCookie = sc.map(function (c) { return c.split(';')[0]; }).join('; ');
+            }
+        }
+        callback({ responseHeaders: details.responseHeaders });
+    });
+    session.defaultSession.webRequest.onBeforeSendHeaders(function (details, callback) {
+        if (deviceCookie && isDeviceUrl(details.url)) {
+            details.requestHeaders['Cookie'] = deviceCookie;
+        }
+        callback({ requestHeaders: details.requestHeaders });
+    });
+});
